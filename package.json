{
  "name": "shafayetul-islam-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-local.mjs site",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:validate": "node --disable-warning=ExperimentalWarning scripts/validate-content.mjs",
    "project:new": "node scripts/new-project.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test scripts/*.test.mjs",
    "smoke": "node scripts/smoke-site.mjs",
    "admin": "node scripts/serve-local.mjs admin"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "type": "module"
}
